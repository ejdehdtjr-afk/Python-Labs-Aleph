# 각자 발급받은 키와 본인 환경의 값을 입력하세요. 실제 .env는 업로드하지 마세요.
DATABASE_URL=mysql+pymysql://YOUR_USER:YOUR_PASSWORD@localhost:3306/my_new_board_db
JWT_SECRET_KEY=YOUR_VALUE_HERE
SECURITY_API_KEY=YOUR_VALUE_HERE
PUBLIC_API_KEY=YOUR_VALUE_HERE
LLM_API_KEY=YOUR_VALUE_HERE
N8N_WEBHOOK_URL=YOUR_N8N_WEBHOOK_URL
STUDENT=YOUR_NAME
AUTO_POST_ON_DENY=0
